{
  "title": "RMS Production Dashboard (Pro Edition)",
  "timezone": "browser",
  "refresh": "5s",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "1. Business & Application Metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Total Student Logins",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(rms_student_logins_total)" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Total Result Uploads",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "sum(rms_result_uploads_total)" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Security Alerts (Failed Admin Logins)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum(rms_failed_admin_logins_total)" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "System Errors (HTTP 500s)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "expr": "sum(increase(http_request_summary_seconds_count{status_code=~\"5..\"}[5m]))" }],
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "row",
      "title": "2. Web Traffic & Status Codes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests / Ingress (Total Traffic)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum(rate(http_request_summary_seconds_count[1m]))", "legendFormat": "Total Requests/sec" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP Status Codes (2xx, 3xx, 4xx, 5xx)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 6 },
      "targets": [{ "expr": "sum by (status_code) (rate(http_request_summary_seconds_count[1m]))", "legendFormat": "HTTP {{status_code}}" }],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*200.*" }, "properties": [ { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*401.*" }, "properties": [ { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*500.*" }, "properties": [ { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } } ] }
        ]
      }
    },
    {
      "type": "row",
      "title": "3. API Latency & Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Latency (Average Percentiles)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "targets": [
        { "expr": "http_request_summary_seconds{quantile=\"0.99\"}", "legendFormat": "P99" },
        { "expr": "http_request_summary_seconds{quantile=\"0.95\"}", "legendFormat": "P95" },
        { "expr": "http_request_summary_seconds{quantile=\"0.5\"}", "legendFormat": "P50 (Median)" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node.js Memory Usage (RAM)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "Memory Bytes" }]
    },
    {
      "type": "timeseries",
      "title": "Node.js CPU Usage",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "targets": [{ "expr": "rate(process_cpu_user_seconds_total[1m]) + rate(process_cpu_system_seconds_total[1m])", "legendFormat": "CPU Time (sec/sec)" }]
    },
    {
      "type": "row",
      "title": "4. Docker Infrastructure Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "stat",
      "title": "Backend API Pods",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 24 },
      "targets": [{ "expr": "count(container_last_seen{container_label_com_docker_compose_service=\"backend\"})" }]
    },
    {
      "type": "stat",
      "title": "Admin UI Pods",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 24 },
      "targets": [{ "expr": "count(container_last_seen{container_label_com_docker_compose_service=\"frontend\"})" }]
    },
    {
      "type": "stat",
      "title": "Student UI Pods",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 24 },
      "targets": [{ "expr": "count(container_last_seen{container_label_com_docker_compose_service=\"student-frontend\"})" }]
    },
    {
      "type": "timeseries",
      "title": "Network Traffic (Bytes Received)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 24 },
      "targets": [{ "expr": "sum(rate(container_network_receive_bytes_total{container_label_com_docker_compose_service=~\".+\"}[1m])) by (container_label_com_docker_compose_service)", "legendFormat": "{{container_label_com_docker_compose_service}} Inbound" }]
    },
    {
      "type": "timeseries",
      "title": "Network Traffic (Bytes Transmitted)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 24 },
      "targets": [{ "expr": "sum(rate(container_network_transmit_bytes_total{container_label_com_docker_compose_service=~\".+\"}[1m])) by (container_label_com_docker_compose_service)", "legendFormat": "{{container_label_com_docker_compose_service}} Outbound" }]
    }
  ],
  "schemaVersion": 38
}
