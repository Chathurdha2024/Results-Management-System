{
  "title": "RMS Production Dashboard (Pro Edition)",
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "type": "row",
      "title": "1. Business & Application Metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Total Student Logins",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(rms_student_logins_total)" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Total Result Uploads",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "sum(rms_result_uploads_total)" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Security Alerts (Failed Admin Logins)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum(rms_failed_admin_logins_total)" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "System Errors (HTTP 500s)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [{ "expr": "sum(increase(http_request_duration_seconds_count{status_code=~\"5..\"}[5m]))" }],
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "row",
      "title": "2. Web Traffic & Status Codes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests / Ingress (Total Traffic)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum(rate(http_request_duration_seconds_count[1m]))", "legendFormat": "Total Requests/sec" }]
    },
    {
      "type": "timeseries",
      "title": "HTTP Status Codes (2xx, 3xx, 4xx, 5xx)",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 6 },
      "targets": [{ "expr": "sum by (status_code) (rate(http_request_duration_seconds_count[1m]))", "legendFormat": "HTTP {{status_code}}" }],
      "fieldConfig": {
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*200.*" }, "properties": [ { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*401.*" }, "properties": [ { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } } ] },
          { "matcher": { "id": "byRegexp", "options": ".*500.*" }, "properties": [ { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } } ] }
        ]
      }
    },
    {
      "type": "row",
      "title": "3. API Latency & Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Latency (Percentiles - 99th, 95th, 50th)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50 (Median)" }
      ],
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Node.js Memory Usage (RAM)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "Memory Bytes" }]
    },
    {
      "type": "row",
      "title": "4. Docker Infrastructure Health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "type": "stat",
      "title": "Active Docker Containers",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 24 },
      "targets": [{ "expr": "count(container_last_seen{name=~\".*results-management.*\"})" }]
    },
    {
      "type": "timeseries",
      "title": "Network Traffic (Bytes Received)",
      "gridPos": { "h": 6, "w": 10, "x": 4, "y": 24 },
      "targets": [{ "expr": "sum(rate(container_network_receive_bytes_total{name=~\".*results-management.*\"}[1m])) by (name)", "legendFormat": "{{name}} Inbound" }]
    },
    {
      "type": "timeseries",
      "title": "Network Traffic (Bytes Transmitted)",
      "gridPos": { "h": 6, "w": 10, "x": 14, "y": 24 },
      "targets": [{ "expr": "sum(rate(container_network_transmit_bytes_total{name=~\".*results-management.*\"}[1m])) by (name)", "legendFormat": "{{name}} Outbound" }]
    }
  ],
  "schemaVersion": 38
}
