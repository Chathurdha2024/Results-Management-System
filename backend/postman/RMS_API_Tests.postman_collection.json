{
  "info": {
    "name": "RMS API Tests",
    "description": "API tests for Results Management System backend (Fastify, port 3000). Run the requests IN ORDER (Collection Runner) because login requests save tokens used by later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "API-01 Student Login - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC01: status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('TC01: response has token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('studentToken', json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regNo\": \"{{studentRegNo}}\",\n  \"password\": \"{{studentPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/student/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "student", "login"] }
          }
        },
        {
          "name": "API-02 Student Login - Wrong Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC02: status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('TC02: error message returned', () => {",
                  "  pm.expect(pm.response.json().error).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regNo\": \"{{studentRegNo}}\",\n  \"password\": \"WrongPassword123!\"\n}"
