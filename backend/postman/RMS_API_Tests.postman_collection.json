    {
      "name": "Security - Cross Role",
      "item": [
        {
          "name": "API-17 Student Dashboard with ADMIN token (role check)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Expected: 401 or 403 (a student-only route should reject an admin-role token).",
                  "// If this returns 200, that is a BROKEN ACCESS CONTROL bug - record it in your QA report!",
                  "pm.test('TC17: student route rejects admin token (401/403)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
